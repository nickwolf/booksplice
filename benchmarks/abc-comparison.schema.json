{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anonymous AudioBookConverter comparison disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "disposition", "reason"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "disposition": { "enum": ["completed", "unavailable", "not-practical"] },
    "reason": { "type": "string", "minLength": 1, "pattern": "^(?!.*[A-Za-z]:[\\\\/]).*$" },
    "version": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "wallSeconds", "outputCodec", "outputBytes", "validationStatus"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^case-[a-z0-9-]+$" },
          "wallSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "childCpuSeconds": { "type": "number", "minimum": 0 },
          "outputCodec": { "type": "string", "minLength": 1 },
          "outputBitrateKbps": { "type": "number", "exclusiveMinimum": 0 },
          "outputBytes": { "type": "integer", "minimum": 1 },
          "chapters": { "type": "integer", "minimum": 0 },
          "metadataDisposition": { "type": "string" },
          "coverDisposition": { "type": "string" },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "validationStatus": { "enum": ["ok", "failed", "not-run"] }
        }
      }
    }
  }
}
