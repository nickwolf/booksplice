{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "cases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string" },
    "generatedBy": { "type": "string" },
    "cases": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["caseId", "sourcePath", "traits", "expectedOrder", "groups", "copyPermission"], "properties": { "caseId": { "type": "string", "minLength": 1, "pattern": "^case-[a-z0-9-]+$" }, "sourcePath": { "type": "string", "minLength": 1 }, "traits": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "expectedOrder": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "groups": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "copyPermission": { "type": "boolean" }, "arguments": { "type": "array", "items": { "type": "string" } }, "expectedProperties": { "type": "object" }, "expectedCorrupt": { "type": "boolean" } } } }
  }
}
