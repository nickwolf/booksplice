<Window x:Class="BookSplice.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:BookSplice.Gui.Controls"
        Title="BookSplice" Height="760" Width="1120" MinWidth="760" MinHeight="520"
        AutomationProperties.AutomationId="BookSpliceMainWindow"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
    <!-- Compact so three fit beside a 45-character name in the default queue width. -->
    <Style x:Key="RowIconButton" TargetType="ctl:IconButton">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="1,0"/>
    </Style>
    <!-- System brushes only, resolved dynamically, so the button stays readable when a high contrast theme is switched on. -->
    <Style x:Key="PrimaryActionButton" TargetType="Button">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Opacity" Value="0.7"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderThickness" Value="3"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <StackPanel Margin="0,0,0,12">
        <TextBlock Text="BookSplice" FontSize="26" FontWeight="SemiBold"/>
        <WrapPanel x:Name="PrimaryActions" HorizontalAlignment="Left" Margin="0,4,0,0">
          <Button Content="Add _folder..." Click="AddFolder_Click" Padding="8,6" Margin="4" VerticalAlignment="Center"
                  AutomationProperties.HelpText="Adds each chosen folder as one book, or previews the books first when it holds several"/>
          <Button Content="Add f_iles..." Click="AddFiles_Click" Padding="8,6" Margin="4" VerticalAlignment="Center"/>
          <Button x:Name="ConvertReadyButton" Content="Convert ready _books" Click="ConvertAll_Click" Style="{StaticResource PrimaryActionButton}" Margin="8,4,4,4" VerticalAlignment="Center"/>
          <ctl:IconButton x:Name="PauseQueueButton" Margin="1,4" Glyph="{Binding QueuePauseGlyph, FallbackValue=&#xE769;}" Content="{Binding QueuePauseLabel, FallbackValue=Pause _queue}"
                          ToolTip="{Binding QueuePauseText, FallbackValue=Pause queue}" AutomationProperties.Name="{Binding QueuePauseText, FallbackValue=Pause queue}"
                          Visibility="{Binding CanPauseQueue, Converter={StaticResource BooleanVisibility}, FallbackValue=Collapsed}" Click="PauseQueue_Click"/>
          <ctl:IconButton x:Name="RetryFailedButton" Margin="1,4" Glyph="&#xE72C;" Content="Retr_y failed" ToolTip="Retry failed books" AutomationProperties.Name="Retry failed books"
                          Visibility="{Binding CanRetryFailed, Converter={StaticResource BooleanVisibility}, FallbackValue=Collapsed}" Click="RetryFailed_Click"/>
          <ctl:IconButton x:Name="ClearCompletedButton" Margin="1,4" Glyph="&#xE894;" Content="Clear com_pleted books" ToolTip="Clear completed books" AutomationProperties.Name="Clear completed books"
                          Visibility="{Binding CanClearCompleted, Converter={StaticResource BooleanVisibility}, FallbackValue=Collapsed}" Click="ClearCompleted_Click"/>
          <ctl:IconButton x:Name="SettingsButton" Margin="1,4" Glyph="&#xE713;" Content="_Settings" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"/>
          <Button x:Name="UpdateAvailableButton" Content="BookSplice update a_vailable" Click="UpdateAvailable_Click" Padding="8,6" Margin="4" VerticalAlignment="Center" Visibility="Collapsed"
                  AutomationProperties.Name="Update available" AutomationProperties.HelpText="Opens Settings on the Updates page"/>
        </WrapPanel>
      </StackPanel>
      <TextBlock x:Name="Destination" TextWrapping="Wrap"/>
      <TextBlock x:Name="DropHint" Text="Drop audiobook folders here. Each folder becomes one book. Add files can make one book from the selected tracks or one book per file." TextWrapping="Wrap" Margin="0,6"
                 Visibility="{Binding IsQueueEmpty, Converter={StaticResource BooleanVisibility}, FallbackValue=Visible}"/>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="Firebrick" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{Binding QueueNotice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <StackPanel Visibility="{Binding IsBatchActive, Converter={StaticResource BooleanVisibility}}" Margin="0,4">
        <TextBlock Text="{Binding BatchProgress}" AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar IsIndeterminate="True" Height="5" AutomationProperties.Name="Analysis progress"/>
      </StackPanel>
    </StackPanel>
    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="9*" MinWidth="200"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="11*" MinWidth="380"/>
      </Grid.ColumnDefinitions>
      <ListBox x:Name="Queue" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="Queue_KeyDown"
               AutomationProperties.Name="Audiobook queue" AutomationProperties.HelpText="Alt+Up and Alt+Down move the selected book, Delete removes it">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <!-- Collapsed when the book has no cover, so no gap is left. -->
              <Image x:Name="RowThumbnail" Source="{Binding Thumbnail}" Width="40" Height="40" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Top"
                     Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanVisibility}}"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding QueueStatus}" Margin="0,4" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,0,0,0">
                <ctl:IconButton Style="{StaticResource RowIconButton}" Glyph="&#xE74A;" IsEnabled="{Binding CanMoveUp}" ToolTip="{Binding MoveUpTip}"
                                AutomationProperties.Name="{Binding MoveUpText}" Click="RowMoveUp_Click"/>
                <ctl:IconButton Style="{StaticResource RowIconButton}" Glyph="&#xE74B;" IsEnabled="{Binding CanMoveDown}" ToolTip="{Binding MoveDownTip}"
                                AutomationProperties.Name="{Binding MoveDownText}" Click="RowMoveDown_Click"/>
                <ctl:IconButton Style="{StaticResource RowIconButton}" Glyph="&#xE74D;" IsEnabled="{Binding CanRemove}" ToolTip="{Binding RemoveTip}"
                                AutomationProperties.Name="{Binding RemoveText}" Click="RowRemove_Click"/>
              </StackPanel>
              <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" Maximum="100" Height="5" AutomationProperties.Name="Conversion progress"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"/>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <DockPanel x:Name="SelectedBookPanel" DataContext="{Binding SelectedItem, ElementName=Queue}">
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,8">
          <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding Source}" TextWrapping="Wrap" Foreground="DimGray"/>
          <!-- The planned file and audio strategy, or a short reason there is no plan. The full reasons, storage estimate and notes are behind the info icon. -->
          <TextBlock x:Name="HeaderOutput" TextWrapping="Wrap" Margin="0,6,0,0" ToolTip="{Binding HeaderFullPath}"
                     Visibility="{Binding HasHeaderPlan, Converter={StaticResource BooleanVisibility}, FallbackValue=Collapsed}"><Run Text="Output: "/><Run Text="{Binding HeaderFileName, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
          <WrapPanel Margin="0,2,0,0">
            <TextBlock x:Name="HeaderAudio" Text="{Binding HeaderAudioText}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Visibility="{Binding HasHeaderPlan, Converter={StaticResource BooleanVisibility}, FallbackValue=Collapsed}"/>
            <TextBlock x:Name="HeaderRefusal" Text="{Binding HeaderRefusalText}" TextWrapping="Wrap" Foreground="Firebrick" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding HasHeaderRefusal, Converter={StaticResource BooleanVisibility}, FallbackValue=Collapsed}"/>
            <ctl:InfoIcon x:Name="HeaderInfo" Subject="the planned output" Text="{Binding HeaderInfoText}" Margin="4,0,0,0" VerticalAlignment="Center"
                          Visibility="{Binding HasHeaderInfo, Converter={StaticResource BooleanVisibility}, FallbackValue=Collapsed}"/>
          </WrapPanel>
          <WrapPanel Margin="0,8">
            <Button x:Name="ConvertSelectedButton" Content="Conve_rt selected" Visibility="{Binding CanConvert, Converter={StaticResource BooleanVisibility}, FallbackValue=Collapsed}" Click="Convert_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="CancelSelectedButton" Content="Cance_l" Visibility="{Binding CanCancel, Converter={StaticResource BooleanVisibility}, FallbackValue=Collapsed}" Click="Cancel_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="CopyDiagnosticsButton" Content="Copy dia_gnostics" Click="CopyDiagnostics_Click" Padding="12,6"/>
          </WrapPanel>
          <!-- Anything else that differs for one book is a preset: apply one here, or save this book's settings as a new one. -->
          <Grid x:Name="BookSettings" IsEnabled="{Binding CanEdit}" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Content="Preset" Target="{Binding ElementName=PresetPicker}" VerticalAlignment="Center"/>
            <ComboBox x:Name="PresetPicker" Grid.Column="1" DisplayMemberPath="Display" VerticalAlignment="Center" AutomationProperties.Name="Preset to apply to the selected book"
                      AutomationProperties.HelpText="Applying copies the preset into this book. Later changes to the preset do not change it"/>
            <Button x:Name="ApplyPresetButton" Grid.Column="2" Content="_Apply" Click="ApplyPreset_Click" Padding="12,4" Margin="6,2,0,2"/>
            <Button x:Name="SavePresetButton" Grid.Column="3" Content="Save as pr_eset..." Click="SavePreset_Click" Padding="12,4" Margin="6,2,0,2"/>
            <Label Grid.Row="1" Content="Destination" Target="{Binding ElementName=BookOutputDirectory}" VerticalAlignment="Center"/>
            <TextBox x:Name="BookOutputDirectory" Grid.Row="1" Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Selected book destination folder"/>
            <Button x:Name="BrowseDestinationButton" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="C_hoose folder..." Click="BrowseDestination_Click" Padding="12,4" Margin="6,2,0,2" HorizontalAlignment="Left"/>
          </Grid>
          <!-- Only while a restored book names a quality or metadata profile that is gone. -->
          <StackPanel x:Name="ProfileFix" Visibility="{Binding IsProfileBlocked, Converter={StaticResource BooleanVisibility}, FallbackValue=Collapsed}">
            <DockPanel Margin="0,4,0,0" Visibility="{Binding QualityProfileMissing, Converter={StaticResource BooleanVisibility}}">
              <Label DockPanel.Dock="Left" Content="Audio quality" Target="{Binding ElementName=MissingQualityPicker}"/>
              <ComboBox x:Name="MissingQualityPicker" ItemsSource="{Binding QualityProfiles}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding QualityProfileId}"
                        AutomationProperties.Name="Audio quality for the selected book"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0" Visibility="{Binding MetadataProfileMissing, Converter={StaticResource BooleanVisibility}}">
              <Label DockPanel.Dock="Left" Content="Metadata profile" Target="{Binding ElementName=MissingMetadataPicker}"/>
              <ComboBox x:Name="MissingMetadataPicker" ItemsSource="{Binding MetadataProfiles}" SelectedItem="{Binding MetadataProfileId}"
                        AutomationProperties.Name="Metadata profile for the selected book"/>
            </DockPanel>
          </StackPanel>
        </StackPanel>
        <Border x:Name="ConversionResultCard" DockPanel.Dock="Top" Margin="8,0,0,8" Padding="12" BorderBrush="Gray" BorderThickness="1"
                Visibility="{Binding HasResult, Converter={StaticResource BooleanVisibility}, FallbackValue=Collapsed}" AutomationProperties.Name="Conversion result">
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
            <StackPanel>
              <TextBlock x:Name="ResultTitle" Text="{Binding Result.Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock Text="{Binding Result.Summary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding Result.OutputText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding Result.ElapsedText}" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding Result.ValidationText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <TextBlock Text="{Binding Result.DecodeText}" TextWrapping="Wrap"/>
              <Button x:Name="OpenResultOutput" Content="_Open output folder" IsEnabled="{Binding CanOpenOutput}" Click="OpenOutput_Click" Padding="12,6" HorizontalAlignment="Left" Margin="0,8"/>
              <StackPanel Visibility="{Binding Result.HasWarnings, Converter={StaticResource BooleanVisibility}}">
                <TextBlock Text="Warnings" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding Result.Warnings}" AutomationProperties.Name="Conversion warnings">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <Expander Header="Validation _checks" Margin="0,8,0,0" AutomationProperties.Name="Validation checks">
                <ItemsControl ItemsSource="{Binding Result.Checks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
              <Expander Header="Diagnostics" AutomationProperties.Name="Tool diagnostics">
                <TextBox Text="{Binding Result.DiagnosticsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Raw tool diagnostics"/>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <TextBox DockPanel.Dock="Bottom" Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" MaxHeight="130" MinHeight="50" Margin="8" AutomationProperties.Name="Status and diagnostics">
          <TextBox.Style>
            <Style TargetType="TextBox">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasResult}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
        <TabControl Margin="8,0,0,0" MinHeight="220">
          <TabItem Header="_Metadata">
            <DockPanel IsEnabled="{Binding CanEdit}" Margin="8">
              <!-- Cover above the grid so one layout fits the minimum window width; the preview is a fixed small square. -->
              <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="CoverImage" Width="140" Height="140" Stretch="Uniform" VerticalAlignment="Top" AutomationProperties.Name="Selected cover preview"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                  <TextBlock Text="Choose artwork to embed. No artwork is required." TextWrapping="Wrap"/>
                  <ComboBox ItemsSource="{Binding Covers}" SelectedItem="{Binding SelectedCover}" SelectionChanged="Cover_Changed" DisplayMemberPath="SourceIdentity"
                            AutomationProperties.Name="Cover artwork" Margin="0,8"/>
                  <CheckBox Content="Do _not embed artwork" IsChecked="{Binding OmitCover}"/>
                  <Button x:Name="EditMetadataButton" Content="Edit meta_data..." Click="EditMetadata_Click" Padding="12,6" Margin="0,12,0,0" HorizontalAlignment="Left"
                          AutomationProperties.HelpText="Opens a larger window for long values such as Comment and Description, with the source values beside each field"/>
                </StackPanel>
              </Grid>
              <DataGrid ItemsSource="{Binding Metadata}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="200" Margin="0,8,0,0"
                        AutomationProperties.Name="Book metadata">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Field" Binding="{Binding Name}" IsReadOnly="True" Width="130"/>
                  <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                  <DataGridTextColumn Header="Imported state" Binding="{Binding State}" IsReadOnly="True" Width="110"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem Header="_Tracks and chapters">
            <StackPanel Margin="8" IsEnabled="{Binding CanEdit}">
              <TextBlock Text="Start from a candidate order, then move or exclude tracks. Alt+Up and Alt+Down move the selected track, Delete excludes it, Enter puts an excluded track back." TextWrapping="Wrap"/>
              <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Track order" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid Grid.Column="1">
                  <ComboBox x:Name="OrderChoice" DisplayMemberPath="Name" SelectionChanged="OrderChoice_Changed" AutomationProperties.Name="Track order"/>
                  <!-- A ComboBox has no placeholder, so this sits over its empty selection box. It never takes the click. -->
                  <TextBlock x:Name="OrderPlaceholder" Text="Choose a track order" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,30,0"
                             Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                </Grid>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,8,0">
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <ctl:IconButton x:Name="TrackUpButton" Style="{StaticResource RowIconButton}" Glyph="&#xE74A;" ToolTip="Move track up" AutomationProperties.Name="Move track up" Click="TrackUp_Click"/>
                      <ctl:IconButton x:Name="TrackDownButton" Style="{StaticResource RowIconButton}" Glyph="&#xE74B;" ToolTip="Move track down" AutomationProperties.Name="Move track down" Click="TrackDown_Click"/>
                      <ctl:IconButton x:Name="TrackExcludeButton" Style="{StaticResource RowIconButton}" Glyph="&#xE738;" ToolTip="Exclude track" AutomationProperties.Name="Exclude track" Click="TrackExclude_Click"/>
                    </StackPanel>
                    <TextBlock Text="Included tracks" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </DockPanel>
                  <ListBox x:Name="IncludedList" ItemsSource="{Binding IncludedTracks}" SelectionChanged="TrackList_SelectionChanged" PreviewKeyDown="IncludedList_KeyDown"
                           MinHeight="96" MaxHeight="200" AutomationProperties.Name="Included tracks in conversion order"/>
                </DockPanel>
                <DockPanel Grid.Column="1">
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <ctl:IconButton x:Name="TrackIncludeButton" Style="{StaticResource RowIconButton}" Glyph="&#xE710;" ToolTip="Put track back" AutomationProperties.Name="Put track back" Click="TrackInclude_Click"/>
                    </StackPanel>
                    <TextBlock Text="Excluded tracks" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </DockPanel>
                  <ListBox x:Name="ExcludedList" ItemsSource="{Binding ExcludedTracks}" SelectionChanged="TrackList_SelectionChanged" PreviewKeyDown="ExcludedList_KeyDown"
                           MinHeight="96" MaxHeight="200" AutomationProperties.Name="Excluded tracks"/>
                </DockPanel>
              </Grid>
              <Button Content="_Use selected order" IsEnabled="{Binding CanApplyTrackList}" Click="Order_Click" Padding="12,6" Margin="0,8,0,12" HorizontalAlignment="Left"/>
              <TextBlock Text="Chapter titles" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <DataGrid ItemsSource="{Binding Chapters}" AutoGenerateColumns="False" MinHeight="120" MaxHeight="240"
                        CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Chapter titles">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Start" Binding="{Binding Start}" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Title" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                  <DataGridTextColumn Header="Source" Binding="{Binding Source}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </TabItem>
        </TabControl>
      </DockPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
