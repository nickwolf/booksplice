<Window x:Class="BookSplice.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BookSplice" Height="560" Width="900" MinWidth="600" MinHeight="400">
  <DockPanel Margin="24">
    <Button DockPanel.Dock="Top" Content="_Settings" HorizontalAlignment="Right" Click="Settings_Click" Padding="16,6"/>
    <StackPanel VerticalAlignment="Center">
      <TextBlock Text="BookSplice" FontSize="28"/>
      <TextBlock x:Name="Destination" TextWrapping="Wrap" Margin="0,12"/>
      <TextBlock Text="Setup is complete. The conversion queue is the next development milestone." TextWrapping="Wrap"/>
    </StackPanel>
  </DockPanel>
</Window>
