<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BookSplice.Core\BookSplice.Core.csproj" />
    <ProjectReference Include="..\BookSplice.FFmpeg\BookSplice.FFmpeg.csproj" />
    <ProjectReference Include="..\BookSplice.Updates\BookSplice.Updates.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BookSplice.Gui.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\BookSplice.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup Condition="'$(BookSplicePackageVersion)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BookSplicePackageVersion</_Parameter1>
      <_Parameter2>$(BookSplicePackageVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
