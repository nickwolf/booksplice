<Window x:Class="BookSplice.Gui.Views.PresetNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preset name" Width="460" SizeToContent="Height" MinWidth="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
  <StackPanel Margin="16">
    <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <Label Content="_Name" Target="{Binding ElementName=NameBox}" Padding="0"/>
    <TextBox x:Name="NameBox" MaxLength="64" AutomationProperties.Name="Preset name"/>
    <CheckBox x:Name="IncludeFolder" Content="Also save the _destination folder" Margin="0,8,0,0"
              AutomationProperties.HelpText="Off by default. Without it, applying the preset leaves the book's folder alone"/>
    <TextBlock x:Name="Problem" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="_Save" IsDefault="True" Click="Save_Click" Padding="16,6" Margin="0,0,8,0"/>
      <Button Content="Cancel" IsCancel="True" Padding="16,6"/>
    </StackPanel>
  </StackPanel>
</Window>
