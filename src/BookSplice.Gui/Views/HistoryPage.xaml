<UserControl x:Class="BookSplice.Gui.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:BookSplice.Gui.Controls"
             AutomationProperties.AutomationId="BookSpliceHistoryPage">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
  </UserControl.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <DockPanel Margin="0,0,0,8">
        <Label Content="_Find:" Target="{Binding ElementName=Search}" DockPanel.Dock="Left"/>
        <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search history"/>
      </DockPanel>
      <TextBlock x:Name="Status" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.Name="History status" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Button Content="C_lear history..." IsEnabled="{Binding CanClear}" Click="Clear_Click" Padding="12,6" Margin="0,0,8,0"/>
      <Button Content="_Refresh" Click="Refresh_Click" Padding="12,6"/>
    </WrapPanel>
    <Expander DockPanel.Dock="Bottom" Header="Records that could not be read" Visibility="{Binding HasSkipped, Converter={StaticResource BooleanVisibility}}" Margin="0,8,0,0">
      <ListBox ItemsSource="{Binding Skipped}" MaxHeight="100" AutomationProperties.Name="Records that could not be read">
        <ListBox.ItemTemplate>
          <DataTemplate><TextBlock TextWrapping="Wrap"><Run Text="{Binding FileName, Mode=OneWay}"/>: <Run Text="{Binding Reason, Mode=OneWay}"/></TextBlock></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Expander>
    <TextBox DockPanel.Dock="Bottom" Text="{Binding SelectedDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
             Height="150" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" AutomationProperties.Name="Selected record details"/>
    <ListView x:Name="Records" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Conversion records"
              VirtualizingPanel.IsVirtualizing="True">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Actions" Width="116">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <ctl:IconButton Glyph="&#xE838;" ToolTip="Open output folder" AutomationProperties.Name="Open output folder" IsEnabled="{Binding CanOpenOutput}" Click="OpenFolder_Click"/>
                  <ctl:IconButton Glyph="&#xE8C8;" ToolTip="Copy diagnostics" AutomationProperties.Name="Copy diagnostics" Click="CopyDiagnostics_Click"/>
                  <ctl:IconButton Glyph="&#xE74D;" ToolTip="Delete record" AutomationProperties.Name="Delete record" Click="Delete_Click"/>
                </StackPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Outcome" DisplayMemberBinding="{Binding OutcomeText}" Width="150"/>
          <GridViewColumn Header="When" DisplayMemberBinding="{Binding WhenText}" Width="130"/>
          <GridViewColumn Header="Elapsed" DisplayMemberBinding="{Binding ElapsedText}" Width="80"/>
          <GridViewColumn Header="Strategy" DisplayMemberBinding="{Binding Strategy}" Width="140"/>
          <GridViewColumn Header="Validation" DisplayMemberBinding="{Binding ValidationLevel}" Width="80"/>
          <GridViewColumn Header="Warnings" DisplayMemberBinding="{Binding WarningCountText}" Width="70"/>
          <GridViewColumn Header="Output" DisplayMemberBinding="{Binding OutputName}" Width="260"/>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</UserControl>
