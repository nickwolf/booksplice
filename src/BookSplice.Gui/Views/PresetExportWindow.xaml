<Window x:Class="BookSplice.Gui.Views.PresetExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export presets" Width="620" Height="480" MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Text="This is exactly what will be written to the file. Local folders are left out unless you include them."/>
    <CheckBox x:Name="IncludeFolder" DockPanel.Dock="Top" Content="Include the _output folder" Margin="0,8" Checked="Include_Changed" Unchecked="Include_Changed"
              AutomationProperties.HelpText="Off by default because the folder is a path on this computer"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="_Save to file..." IsDefault="True" Click="Save_Click" Padding="16,6" Margin="0,0,8,0"/>
      <Button Content="Cancel" IsCancel="True" Padding="16,6"/>
    </StackPanel>
    <TextBox x:Name="Preview" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Export preview"/>
  </DockPanel>
</Window>
