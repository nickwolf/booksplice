<Window x:Class="BookSplice.Gui.Views.FirstLaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up BookSplice" Width="600" Height="450" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="24,8,24,16" IsEnabled="{Binding CanEdit}">
      <TextBlock x:Name="LockedNotice" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock x:Name="Error" Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CloseButton" Content="_Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
        <Button x:Name="SaveButton" Content="_Save and continue" IsDefault="True" Click="Save_Click" Padding="16,6"/>
      </StackPanel>
    </StackPanel>
    <ContentControl x:Name="Host" IsTabStop="False"/>
  </DockPanel>
</Window>
