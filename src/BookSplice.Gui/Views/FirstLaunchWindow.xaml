<Window x:Class="BookSplice.Gui.Views.FirstLaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up BookSplice" Width="600" Height="450" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" IsEnabled="{Binding CanEdit}">
      <TextBlock Text="Welcome to BookSplice" FontSize="24" Margin="0,0,0,12"/>
      <TextBlock Text="Choose where finished audiobooks go. Source files stay unchanged." TextWrapping="Wrap" Margin="0,0,0,16"/>
      <Label Content="_Where should completed M4B files be placed?" Target="{Binding ElementName=OutputFolder}"/>
      <DockPanel Margin="0,0,0,16">
        <Button DockPanel.Dock="Right" Content="_Browse..." Click="Browse_Click" Padding="12,5" Margin="8,0,0,0"/>
        <TextBox x:Name="OutputFolder" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Output folder" VerticalContentAlignment="Center"/>
      </DockPanel>
      <Label Content="_Audio quality" Target="{Binding ElementName=Quality}"/>
      <ComboBox x:Name="Quality" ItemsSource="{Binding QualityProfiles}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding QualityProfileId}" AutomationProperties.Name="Audio quality" Margin="0,0,0,12"/>
      <TextBlock Text="Source channels are preserved by default. Advanced settings can force mono or stereo output." TextWrapping="Wrap" Margin="0,0,0,12"/>
      <CheckBox Content="_Create chapters from source file boundaries" IsChecked="{Binding CreateChapters}" Margin="0,0,0,16"/>
      <Expander Header="_Advanced settings" Margin="0,0,0,12">
        <StackPanel>
          <Label Content="Parallel encoding _jobs (blank uses Automatic)" Target="{Binding ElementName=Jobs}" Margin="0,8,0,4"/>
          <ComboBox x:Name="Jobs" ItemsSource="{Binding JobChoices}" SelectedItem="{Binding ConversionJobs}" AutomationProperties.Name="Parallel encoding jobs"/>
          <Label Content="Channel _handling" Target="{Binding ElementName=Channels}" Margin="0,8,0,4"/>
          <ComboBox x:Name="Channels" ItemsSource="{Binding ChannelPolicies}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ChannelPolicy}" AutomationProperties.Name="Channel handling"/>
          <Label Content="_Metadata profile" Target="{Binding ElementName=MetadataProfile}" Margin="0,8,0,4"/>
          <ComboBox x:Name="MetadataProfile" ItemsSource="{Binding MetadataProfiles}" SelectedItem="{Binding MetadataProfileId}" AutomationProperties.Name="Metadata profile"/>
          <Label Content="_Validation (Full decodes the entire output)" Target="{Binding ElementName=Validation}" Margin="0,8,0,4"/>
          <ComboBox x:Name="Validation" ItemsSource="{Binding ValidationLevels}" SelectedItem="{Binding ValidationLevel}" AutomationProperties.Name="Validation level"/>
          <Label Content="_Logging level" Target="{Binding ElementName=Logging}" Margin="0,8,0,4"/>
          <ComboBox x:Name="Logging" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" AutomationProperties.Name="Logging level"/>
        </StackPanel>
      </Expander>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
        <Button Content="_Save and continue" IsDefault="True" Click="Save_Click" Padding="16,6"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
