<Window x:Class="BookSplice.Gui.Views.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BookSplice updates" Width="620" Height="560" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="BookSpliceUpdatesWindow">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <TextBlock Text="Updates" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding InstalledVersion, StringFormat='Running version: {0}'}" AutomationProperties.Name="Running version"/>
      <TextBlock Text="{Binding LastSuccessText, StringFormat='Last successful check: {0}'}" AutomationProperties.Name="Last successful check" Margin="0,2,0,8"/>
      <CheckBox x:Name="Automatic" Content="Check for updates _daily" IsChecked="{Binding AutomaticChecksEnabled}" AutomationProperties.Name="Check for updates daily" Margin="0,0,0,8"/>
      <TextBlock x:Name="Status" Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,8"
                 AutomationProperties.Name="Update status" AutomationProperties.LiveSetting="Polite"/>
      <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,8" AutomationProperties.Name="Update progress"
                   Visibility="{Binding CanCancel, Converter={StaticResource BooleanVisibility}}"/>
      <StackPanel Visibility="{Binding HasAvailable, Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,8">
        <TextBlock Text="{Binding AvailableVersion, StringFormat='Available version: {0}'}" AutomationProperties.Name="Available version"/>
        <TextBlock Text="Release notes" FontWeight="SemiBold" Margin="0,8,0,2"/>
        <TextBox Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="160"
                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Release notes"/>
        <TextBlock Text="{Binding InstallLocationText}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="Installation location and shortcut"/>
        <WrapPanel Margin="0,10,0,0">
          <Button x:Name="Install" Content="_Install and restart" IsEnabled="{Binding CanInstall}" Click="Install_Click" Padding="12,6" Margin="0,0,8,0"/>
          <Button Content="_Later" Click="Later_Click" Padding="12,6" Margin="0,0,8,0"/>
          <Button Content="Open release _page" IsEnabled="{Binding HasReleaseUrl}" Click="OpenRelease_Click" Padding="12,6" Margin="0,0,8,0"/>
          <Button Content="_Cancel update" Visibility="{Binding CanCancel, Converter={StaticResource BooleanVisibility}}" Click="Cancel_Click" Padding="12,6"/>
        </WrapPanel>
      </StackPanel>
      <WrapPanel Margin="0,8,0,0">
        <Button x:Name="Check" Content="Check for _updates" IsEnabled="{Binding CanCheck}" Click="Check_Click" Padding="12,6" Margin="0,0,8,0"/>
        <Button Content="_Roll back to previous version" IsEnabled="{Binding CanRollbackNow}" Click="Rollback_Click" Padding="12,6" Margin="0,0,8,0"/>
        <Button Content="C_lose" IsCancel="True" Click="Close_Click" Padding="12,6"/>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
