<Window x:Class="BookSplice.Gui.Views.EditCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit a copy" Width="720" Height="680" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        AutomationProperties.AutomationId="EditCopyWindow">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="CreateButton" Content="C_reate copy" IsDefault="True" IsEnabled="{Binding CanCreate}" Click="Create_Click" Padding="16,6" Margin="0,0,8,0"
              AutomationProperties.HelpText="Saves a new M4B with these changes. The original file is not touched"/>
      <Button x:Name="CancelButton" Content="_Cancel" IsCancel="True" Padding="16,6"/>
    </StackPanel>
    <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Change a tag or a chapter title, then create a copy. The original file is left alone. An empty tag is removed from the copy."/>
    <!-- The change list stays in view while the fields scroll. -->
    <Border DockPanel.Dock="Bottom" BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,8,0,0">
      <StackPanel>
        <TextBlock Text="Changes" FontWeight="SemiBold"/>
        <TextBlock x:Name="PreviewPlaceholder" Text="{Binding PreviewPlaceholder}" Foreground="DimGray" Margin="0,4,0,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="130" Focusable="False">
          <ItemsControl x:Name="PreviewList" ItemsSource="{Binding Preview}" AutomationProperties.Name="Changes to be saved">
            <ItemsControl.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="ProblemText" Text="{Binding ProblemText}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
        <TextBlock Text="Tags" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <!-- An edit copy writes text tags only, so a field the profile stores as a number is shown but can't be changed. -->
        <TextBlock x:Name="ReadOnlyNote" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,6"
                   Visibility="{Binding HasReadOnlyFields, Converter={StaticResource BooleanVisibility}}"
                   Text="Grayed-out fields are stored as numbers by this metadata profile. A copy can only change text tags, so they can't be edited here."/>
        <ItemsControl x:Name="Fields" ItemsSource="{Binding Fields}" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Tags">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,0,8,6">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="160" VerticalAlignment="Center"/>
                <TextBox x:Name="ValueBox" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Label}">
                  <TextBox.Style>
                    <Style TargetType="TextBox">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                          <Setter Property="Foreground" Value="DimGray"/>
                          <Setter Property="Background" Value="WhiteSmoke"/>
                          <Setter Property="ToolTip" Value="Stored as a number, so a copy can't change it"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBox.Style>
                </TextBox>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Chapter titles" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <ItemsControl x:Name="ChapterList" ItemsSource="{Binding Chapters}" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Chapter titles">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,8,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Start}" VerticalAlignment="Center" Foreground="DimGray"/>
                <TextBox x:Name="TitleBox" Grid.Column="2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{Binding Number, StringFormat=Title of chapter {0}}">
                  <TextBox.Style>
                    <Style TargetType="TextBox">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                          <Setter Property="BorderBrush" Value="Firebrick"/>
                          <Setter Property="BorderThickness" Value="2"/>
                          <Setter Property="ToolTip" Value="A chapter needs a title"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBox.Style>
                </TextBox>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
