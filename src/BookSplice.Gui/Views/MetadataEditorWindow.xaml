<Window x:Class="BookSplice.Gui.Views.MetadataEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit metadata" Width="760" Height="640" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        AutomationProperties.AutomationId="MetadataEditorWindow">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="_OK" IsDefault="True" Click="Ok_Click" Padding="16,6" Margin="0,0,8,0"/>
      <Button x:Name="CancelButton" Content="_Cancel" IsCancel="True" Padding="16,6"/>
    </StackPanel>
    <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
    <TextBlock DockPanel.Dock="Top" Text="An empty value clears the field. Comment and Description can hold several lines." TextWrapping="Wrap" Margin="0,0,0,8"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <ItemsControl x:Name="Fields" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Metadata fields">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,8,12">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
              <TextBox x:Name="ValueBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                       AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Description}"/>
              <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,2,0,0"/>
            </StackPanel>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsLongForm}" Value="True">
                <Setter TargetName="ValueBox" Property="AcceptsReturn" Value="True"/>
                <Setter TargetName="ValueBox" Property="TextWrapping" Value="Wrap"/>
                <Setter TargetName="ValueBox" Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter TargetName="ValueBox" Property="MinHeight" Value="110"/>
                <Setter TargetName="ValueBox" Property="VerticalContentAlignment" Value="Top"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
